name: Build and Release

on:
  workflow_dispatch:
    inputs:
      version:
        description: Version tag (e.g. 2.1, 2.1b7)
        required: true
        type: string
      branch:
        description: Release branch
        required: true
        default: prerelease
        type: choice
        options:
          - release
          - prerelease

jobs:
  build-x64:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python x64
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          architecture: x64

      - name: Install dependencies
        run: pip install . pyinstaller

      - name: Inject version
        shell: pwsh
        run: |
          $ver = "${{ inputs.version }}"
          $path = "src\zapret_zen\__init__.py"
          (Get-Content $path) -replace '__version__ = ".*"', '__version__ = "' + $ver + '"' | Set-Content $path
          $path2 = "installer\install_zapretzen.py"
          (Get-Content $path2) -replace "(?<=INSTALLER_VERSION\s*=\s*`")[^`"]*", $ver | Set-Content $path2

      - name: Sync app icon
        run: python scripts/sync_app_icon.py

      - name: Build portable x64
        run: pyinstaller packaging/zapret_zen.spec --distpath dist_portable --workpath build_pyinstaller --noconfirm

      - name: Package portable x64
        shell: pwsh
        run: |
          $ver = "${{ inputs.version }}"
          Compress-Archive -Path dist_portable\zapret_zen\* -DestinationPath "ZapretZen_${ver}_portable_win_x64.zip" -CompressionLevel Optimal -Force

      - name: Prepare installer payload
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Path installer_payload -Force | Out-Null
          $zipPath = Join-Path installer_payload "win_x64.zip"
          $tempDir = Join-Path $env:TEMP "payload_x64"
          New-Item -ItemType Directory -Path $tempDir\zapret_zen -Force | Out-Null
          Copy-Item -LiteralPath dist_portable\zapret_zen\* -Destination $tempDir\zapret_zen -Recurse -Force
          Compress-Archive -Path "$tempDir\*" -DestinationPath $zipPath -CompressionLevel Optimal -Force
          Remove-Item $tempDir -Recurse -Force

      - name: Build installer
        run: pyinstaller packaging/install_zapretzen.spec --distpath dist_installer --workpath build_installer --noconfirm

      - name: Rename installer
        shell: pwsh
        run: |
          $ver = "${{ inputs.version }}"
          Copy-Item dist_installer\install_zapretzen.exe "install_zapretzen_${ver}_universal.exe" -Force

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: artifacts-x64
          path: |
            ZapretZen_*.zip
            install_zapretzen_*.exe
          retention-days: 1

  build-arm64:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python ARM64
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          architecture: arm64

      - name: Install dependencies
        run: pip install . pyinstaller

      - name: Inject version
        shell: pwsh
        run: |
          $ver = "${{ inputs.version }}"
          $path = "src\zapret_zen\__init__.py"
          (Get-Content $path) -replace '__version__ = ".*"', '__version__ = "' + $ver + '"' | Set-Content $path

      - name: Sync app icon
        run: python scripts/sync_app_icon.py

      - name: Build portable ARM64
        run: pyinstaller packaging/zapret_zen.spec --distpath dist_portable --workpath build_pyinstaller --noconfirm

      - name: Package portable ARM64
        shell: pwsh
        run: |
          $ver = "${{ inputs.version }}"
          Compress-Archive -Path dist_portable\zapret_zen\* -DestinationPath "ZapretZen_${ver}_portable_win_arm64.zip" -CompressionLevel Optimal -Force

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: artifacts-arm64
          path: ZapretZen_*_win_arm64.zip
          retention-days: 1

  release:
    needs: [build-x64, build-arm64]
    runs-on: ubuntu-latest
    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          pattern: artifacts-*
          merge-multiple: true

      - name: Create or update release
        uses: ncipollo/release-action@v1
        with:
          tag: ${{ inputs.version }}
          name: ${{ inputs.version }}
          body: ${{ inputs.version }}
          prerelease: ${{ inputs.branch == 'prerelease' }}
          artifacts: |
            ZapretZen_*.zip
            install_zapretzen_*.exe
          artifactContentType: application/zip
          allowUpdates: true
          updateOnlyUnreleased: false
          omitBodyDuringUpdate: true
          omitNameDuringUpdate: true
          replacesArtifacts: true
